{
  "name": "baseline_v1",
  "version": "2026-05-11_215742",
  "notes": "Initiales Kriterien-Set",
  "rules": [
    {
      "id": "qc_self_labeled",
      "active": true,
      "type": "ref_list_match",
      "column": "Asset ID",
      "ref_list": "qc_self_labeled_assets",
      "action": "exclude_from_prio",
      "reason": "Wird durch QC selbst gelabelt",
      "priority": "",
      "when": "",
      "priority_substage": "",
      "mark_shutdown": ""
    },
    {
      "id": "prio1_asset_len_gt_threshold",
      "active": true,
      "type": "",
      "column": "",
      "ref_list": "",
      "action": "assign_prio",
      "reason": "Asset-ID länger als 34 Zeichen",
      "priority": "P1",
      "when": "{'op': '>', 'column': 'asset_id_length', 'value': 34.0}",
      "priority_substage": "",
      "mark_shutdown": ""
    },
    {
      "id": "prio1a_short_but_hard_access",
      "active": true,
      "type": "",
      "column": "",
      "ref_list": "",
      "action": "assign_prio",
      "reason": "<= 34 Zeichen, aber schwer zugänglich: Relabeling nur bei Unterbruch",
      "priority": "P1",
      "when": "{'op': 'AND', 'conditions': [{'op': '<=', 'column': 'asset_id_length', 'value': 34.0}, {'op': 'REGEX', 'column': 'Zugänglichkeit ', 'pattern': 'schwer|sehr\\\\s*schwer'}]}",
      "priority_substage": "1A",
      "mark_shutdown": true
    }
  ]
}